# ── Windows 保留设备名文件 ──
nul

# ── Qoder IDE 配置 ──
.qoder/

# ── IDE ──
.idea/
*.iml
.vscode/
*.swp
*.swo

# ── Java / Maven ──
target/
*.class
*.jar
*.war
*.ear
*.log

# ── Gradle ──
.gradle/
build/

# ── Node.js / 前端 ──
node_modules/
.next/
out/
dist/
.turbo/
coverage/
.eslintcache

# ── 环境变量（含 Next.js） ──
.env
.env.local
.env.*.local
.env.production

# ── 数据卷（Docker 挂载目录） ──
appdata/

# ── 过程文档（docs/ 不入库，仅本地保留；正式代码与项目宪法入版本控制） ──
# 例外：docs/data 为 RAG 知识库示例数据，随仓库分发（见 README.md）；需先排除 docs/ 整体，
# 再反向豁免子目录，否则 git 不会下探被忽略目录，豁免规则不生效
docs/*
!docs/data/

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Superpowers SDD 工作区 ──
.superpowers/

# ── 工具状态目录（不入库） ──
.zcode/
.workbuddy/
.claude/
.playwright-cli/

# ── Maven 本地调试输出 ──
backend/mvn-log.txt
backend/mvn-clean.txt
backend/cp.txt
mvn-test-output.txt
